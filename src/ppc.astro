---
import Layout from '../layouts/Layout.astro';

const title = "San Francisco PPC Management | Google Ads Agency";
const description = "Expert Pay-Per-Click (PPC) management services in San Francisco. Maximize ROI with targeted Google Ads and Bing Ads campaigns managed by certified professionals.";
---

<Layout title={title} description={description}>
  <section class="bg-gray-900 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        San Francisco PPC Services
      </h1>
      <p class="mt-4 text-xl text-gray-300 max-w-3xl mx-auto">
        Drive immediate, highly targeted traffic to your website. Our certified PPC experts optimize your ad spend to ensure maximum Return on Investment (ROI).
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center flex-row-reverse">
        <div class="order-2 lg:order-1">
          <img 
            src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" 
            alt="Data analytics dashboard on a laptop showing PPC campaign performance" 
            class="rounded-lg shadow-xl"
            width="800"
            height="533"
          />
        </div>
        <div class="order-1 lg:order-2 mt-10 lg:mt-0">
          <h2 class="text-3xl font-extrabold text-gray-900">Data-Driven Ad Campaigns</h2>
          <p class="mt-4 text-lg text-gray-600">
            Stop wasting money on ineffective ads. We manage your Google Ads and social media advertising with precision targeting based on San Francisco demographics and user intent.
          </p>
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-gray-50 p-4 rounded-md border border-gray-100">
              <h3 class="font-bold text-lg text-gray-900">Google Ads</h3>
              <p class="text-gray-600 text-sm mt-1">Search, Display, and Video campaigns designed to convert.</p>
            </div>
            <div class="bg-gray-50 p-4 rounded-md border border-gray-100">
              <h3 class="font-bold text-lg text-gray-900">Retargeting</h3>
              <p class="text-gray-600 text-sm mt-1">Re-engage past visitors and turn them into loyal customers.</p>
            </div>
            <div class="bg-gray-50 p-4 rounded-md border border-gray-100">
              <h3 class="font-bold text-lg text-gray-900">A/B Testing</h3>
              <p class="text-gray-600 text-sm mt-1">Continuous optimization of ad copy and landing pages.</p>
            </div>
            <div class="bg-gray-50 p-4 rounded-md border border-gray-100">
              <h3 class="font-bold text-lg text-gray-900">Detailed Reporting</h3>
              <p class="text-gray-600 text-sm mt-1">Transparent dashboards showing exactly where your budget goes.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-blue-600 text-white py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-extrabold">Stop guessing with your ad spend.</h2>
      <p class="mt-4 text-xl text-blue-100">Get a complimentary PPC account review from our SF team.</p>
      <div class="mt-8">
        <a href="#" class="inline-block bg-white text-blue-600 px-8 py-4 rounded-md font-bold text-lg hover:bg-blue-50 transition-colors">Get Your Free PPC Audit</a>
      </div>
    </div>
  </section>
</Layout>