---
import Layout from '../layouts/Layout.astro';

const title = "San Francisco Social Media Marketing | SMM Agency";
const description = "Engage your audience and build brand loyalty with professional Social Media Marketing (SMM) services in San Francisco. Expert management for Facebook, Instagram, LinkedIn, and more.";
---

<Layout title={title} description={description}>
  <section class="bg-gray-900 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        San Francisco Social Media Marketing
      </h1>
      <p class="mt-4 text-xl text-gray-300 max-w-3xl mx-auto">
        Build a community around your brand. Our SMM strategies increase brand awareness, foster engagement, and drive social traffic to your website.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <h2 class="text-3xl font-extrabold text-gray-900">Engage the Bay Area Audience</h2>
          <p class="mt-4 text-lg text-gray-600">
            Social media is where your customers spend their time. We help you create compelling content that resonates with the unique San Francisco demographic, building trust and brand loyalty.
          </p>
          <ul class="mt-8 space-y-4">
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-2">✓</span>
              <span class="text-gray-700"><strong>Content Creation:</strong> High-quality visuals and compelling copy.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-2">✓</span>
              <span class="text-gray-700"><strong>Community Management:</strong> Active engagement and prompt responses.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-2">✓</span>
              <span class="text-gray-700"><strong>Paid Social Campaigns:</strong> Targeted ads on Facebook, Instagram, and LinkedIn.</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-2">✓</span>
              <span class="text-gray-700"><strong>Influencer Partnerships:</strong> Connecting with local SF influencers.</span>
            </li>
          </ul>
        </div>
        <div class="mt-10 lg:mt-0">
          <img 
            src="https://images.unsplash.com/photo-1611162616305-c69b3fa7fbe0?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" 
            alt="Person holding smartphone with Instagram icon on screen, representing social media marketing" 
            class="rounded-lg shadow-xl"
            width="800"
            height="533"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-extrabold text-gray-900">Ready to go viral?</h2>
      <p class="mt-4 text-xl text-gray-500">Let's discuss how we can elevate your social media presence.</p>
      <div class="mt-8">
        <a href="#" class="inline-block bg-blue-600 text-white px-8 py-4 rounded-md font-bold text-lg hover:bg-blue-700 transition-colors">Start Your SMM Campaign</a>
      </div>
    </div>
  </section>
</Layout>