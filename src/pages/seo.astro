import Layout from '../layouts/Layout.astro';

const title = "San Francisco SEO Services | Rank Higher on Google";
const description = "Professional Local SEO and Enterprise SEO services in San Francisco. We help businesses rank on the first page of Google to drive organic traffic and leads.";
---

<Layout title={title} description={description}>
  <section class="bg-gray-900 text-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl">
        San Francisco SEO Services
      </h1>
      <p class="mt-4 text-xl text-gray-300 max-w-3xl mx-auto">
        Dominate the search results in the Bay Area. We use data-driven SEO strategies to get your business in front of the right customers at the exact moment they are searching for your products or services.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="lg:grid lg:grid-cols-2 lg:gap-12 items-center">
        <div>
          <h2 class="text-3xl font-extrabold text-gray-900">Why Local SEO Matters in SF</h2>
          <p class="mt-4 text-lg text-gray-600">
            San Francisco is a highly competitive market. If your business isn't showing up in the Local Pack or on the first page of organic results, you are losing customers to your competitors.
          </p>
          <ul class="mt-8 space-y-4">
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-2">✓</span>
              <span class="text-gray-700">Comprehensive Website Audits & Technical SEO</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-2">✓</span>
              <span class="text-gray-700">Local Keyword Research (e.g., "best marketing agency SF")</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-2">✓</span>
              <span class="text-gray-700">Google Business Profile Optimization</span>
            </li>
            <li class="flex items-start">
              <span class="text-blue-600 font-bold mr-2">✓</span>
              <span class="text-gray-700">High-Quality Local Link Building</span>
            </li>
          </ul>
        </div>
        <div class="mt-10 lg:mt-0">
          <img 
            src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" 
            alt="Team discussing SEO strategy and looking at data charts" 
            class="rounded-lg shadow-xl"
            width="800"
            height="533"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-extrabold text-gray-900">Ready to boost your rankings?</h2>
      <p class="mt-4 text-xl text-gray-500">Contact us today for a free SEO audit of your San Francisco business website.</p>
      <div class="mt-8">
        <a href="#" class="inline-block bg-blue-600 text-white px-8 py-4 rounded-md font-bold text-lg hover:bg-blue-700 transition-colors">Request a Free SEO Audit</a>
      </div>
    </div>
  </section>
</Layout>
